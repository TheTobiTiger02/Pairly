<?xml version="1.0" encoding="utf-8"?>
<!-- Installing through this file (not the raw .msix) registers the update source: Windows then
     re-reads the Uri below on every launch and in the background, and installs newer releases
     without prompting. -->
<AppInstaller
  xmlns="http://schemas.microsoft.com/appx/appinstaller/2021"
  Version="__VERSION__"
  Uri="__LATEST_BASE_URL__/SmartphoneLink.appinstaller">
  <MainPackage
    Name="SmartphoneLink.Private"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64"
    Uri="__RELEASE_BASE_URL__/SmartphoneLink.msix" />
  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="0" ShowPrompt="false" UpdateBlocksActivation="false" />
    <AutomaticBackgroundTask />
    <ForceUpdateFromAnyVersion>true</ForceUpdateFromAnyVersion>
  </UpdateSettings>
</AppInstaller>
