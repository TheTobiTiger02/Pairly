<UserControl x:Class="SmartphoneLink.Windows.Controls.BrandMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="40" Height="40">
            <!-- Two offset screens joined by a continuous link: an original Smartphone Link motif. -->
            <Border Canvas.Left="5" Canvas.Top="3" Width="23" Height="31" CornerRadius="6"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2.3" />
            <Border Canvas.Left="12" Canvas.Top="8" Width="23" Height="29" CornerRadius="6"
                    Background="{DynamicResource NavigationBrush}"
                    BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="2.3" />
            <Path Data="M 9,23 C 13,17 18,17 22,22 C 26,27 30,26 33,21"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse Canvas.Left="20" Canvas.Top="31" Width="5" Height="2"
                     Fill="{DynamicResource TextSecondaryBrush}" />
        </Canvas>
    </Viewbox>
</UserControl>
