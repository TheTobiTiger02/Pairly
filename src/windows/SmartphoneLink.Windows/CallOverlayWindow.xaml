<Window x:Class="SmartphoneLink.Windows.CallOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartphoneLink.Windows.Controls"
        Title="Phone call" Icon="Assets/SmartphoneLink.ico" Height="206" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Style="{StaticResource {x:Type Window}}"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Window.Resources>
        <!-- Call buttons are coloured like the phone's own: green answers, red ends. -->
        <Style x:Key="CallButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="AnswerCallButton" TargetType="Button" BasedOn="{StaticResource CallButton}">
            <Setter Property="Background" Value="#FF0F7B0F" />
        </Style>
        <Style x:Key="EndCallButton" TargetType="Button" BasedOn="{StaticResource CallButton}">
            <Setter Property="Background" Value="#FFC42B1C" />
        </Style>
        <Style x:Key="CallButtonGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <!-- The outer margin leaves room for the shadow inside the transparent window. -->
    <Border Margin="12,8,12,16" Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource OverlayRadius}"
            BorderBrush="{DynamicResource FlyoutStrokeBrush}" BorderThickness="1" Effect="{StaticResource DialogShadow}">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <controls:BrandMark Width="14" Height="14" Margin="0,0,8,0" />
                <TextBlock Text="Pairly · " Style="{StaticResource CaptionText}" />
                <TextBlock x:Name="StateText" Text="Incoming call" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Top">
                    <TextBlock Text="&#xE77B;" Style="{StaticResource IconGlyph}" FontSize="22" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CallerNameText" Text="Unknown caller" Style="{StaticResource SubtitleText}" FontSize="18" />
                    <TextBlock x:Name="CallerNumberText" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    <TextBlock x:Name="HintText" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Call audio stays on the phone or its Bluetooth headset." Visibility="Collapsed" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="SilenceButton" Style="{StaticResource SecondaryButton}" MinWidth="88" Height="36" Margin="0,0,8,0" Tag="silence"
                        Click="Action_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7ED;" Style="{StaticResource CallButtonGlyph}" />
                        <TextBlock Text="Silence" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeclineButton" Style="{StaticResource EndCallButton}" Margin="0,0,8,0" Tag="reject" Click="Action_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE778;" Style="{StaticResource CallButtonGlyph}" />
                        <TextBlock Text="Decline" />
                    </StackPanel>
                </Button>
                <Button x:Name="AnswerButton" Style="{StaticResource AnswerCallButton}" Tag="answer" Click="Action_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE717;" Style="{StaticResource CallButtonGlyph}" />
                        <TextBlock Text="Answer" />
                    </StackPanel>
                </Button>
                <Button x:Name="HangUpButton" Style="{StaticResource EndCallButton}" MinWidth="112" Tag="hangup" Visibility="Collapsed"
                        Click="Action_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE778;" Style="{StaticResource CallButtonGlyph}" />
                        <TextBlock Text="Hang up" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
