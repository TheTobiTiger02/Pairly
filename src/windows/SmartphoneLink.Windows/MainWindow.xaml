<Window x:Class="SmartphoneLink.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SmartphoneLink.Windows.Controls"
        mc:Ignorable="d"
        Title="Smartphone Link" Icon="Assets/SmartphoneLink.ico" Width="1320" Height="860" MinWidth="980" MinHeight="640"
        Style="{StaticResource {x:Type Window}}"
        SizeChanged="MainWindow_SizeChanged" AllowDrop="True" DragOver="MainWindow_DragOver" Drop="MainWindow_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <controls:InverseBooleanConverter x:Key="InverseBool" />

        <Style x:Key="TabGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style x:Key="TabLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style x:Key="PaneHeader" TargetType="TextBlock" BasedOn="{StaticResource SubtitleText}" />
        <Style x:Key="QuickActionGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,2,0,5" />
        </Style>
        <Style x:Key="SettingsCardGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Margin" Value="4,0,18,0" />
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style x:Key="SettingsCardTitle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsCardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="SettingsCardControl" TargetType="FrameworkElement">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style x:Key="EmptyStateGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Avatar" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        </Style>
        <Style x:Key="AvatarInitials" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Visible only while the bound list has no selection. -->
        <Style x:Key="NoThreadSelected" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=SmsThreadsList}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThreadSelected" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=SmsThreadsList}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NoDeviceSelected" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=DevicesList}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceSelected" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=DevicesList}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn" Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title bar: brand, feature tabs, host status, settings and caption buttons. -->
        <Grid Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" HorizontalAlignment="Left">
                <controls:BrandMark Width="18" Height="18" />
                <TextBlock x:Name="BrandTitleText" Text="Smartphone Link" FontSize="12" Margin="12,0,0,1" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="TopTabsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton x:Name="MessagesNav" GroupName="MainNavigation" IsChecked="True" Tag="0" Style="{StaticResource TopTabButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="Messages" ToolTip="Messages">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BD;" Style="{StaticResource TabGlyph}" />
                        <TextBlock x:Name="MessagesTabLabel" Text="Messages" Style="{StaticResource TabLabel}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="MainNavigation" Tag="1" Style="{StaticResource TopTabButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="Photos" ToolTip="Photos">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB9F;" Style="{StaticResource TabGlyph}" />
                        <TextBlock x:Name="PhotosTabLabel" Text="Photos" Style="{StaticResource TabLabel}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="MainNavigation" Tag="2" Style="{StaticResource TopTabButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="Files" ToolTip="Files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource TabGlyph}" />
                        <TextBlock x:Name="FilesTabLabel" Text="Files" Style="{StaticResource TabLabel}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="MainNavigation" Tag="3" Style="{StaticResource TopTabButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="Apps" ToolTip="Apps">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71D;" Style="{StaticResource TabGlyph}" />
                        <TextBlock x:Name="AppsTabLabel" Text="Apps" Style="{StaticResource TabLabel}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border Style="{StaticResource StatusPill}" VerticalAlignment="Center" Margin="0,8,8,0"
                        ToolTip="Connection between this window and the Smartphone Link host">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RealtimeStatusDot" Width="6" Height="6" Fill="{DynamicResource CautionBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="RealtimeStatusText" Text="Starting" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <RadioButton x:Name="SettingsNav" GroupName="MainNavigation" Tag="4" Style="{StaticResource TopTabButton}"
                             Width="40" Padding="0" Margin="0,6,6,0" VerticalAlignment="Top" Checked="Navigate_Click"
                             AutomationProperties.Name="Settings" ToolTip="Settings">
                    <TextBlock Text="&#xE713;" Style="{StaticResource TabGlyph}" />
                </RadioButton>
                <controls:CaptionButtons />
            </StackPanel>
        </Grid>

        <!-- Left pane: phone card, now playing, notification feed. -->
        <Grid x:Name="LeftPane" Grid.Row="1" Margin="12,4,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Phone card -->
            <Border Style="{StaticResource PageCard}" Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="DevicePickerToggle" Style="{StaticResource SubtleToggleButton}" Padding="6"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=DevicePickerPopup, Converter={StaticResource InverseBool}}"
                                      AutomationProperties.Name="Choose phone" ToolTip="Choose which phone to use">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSubtleBrush}">
                                    <TextBlock Text="&#xE8EA;" Style="{StaticResource IconGlyph}" FontSize="20" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Style="{StaticResource DeviceSelected}">
                                        <TextBlock Text="{Binding SelectedItem.DisplayName, ElementName=DevicesList}"
                                                   FontSize="16" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding SelectedItem.StatusBrush, ElementName=DevicesList}" />
                                            <TextBlock Text="{Binding SelectedItem.StatusText, ElementName=DevicesList}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource NoDeviceSelected}">
                                        <TextBlock Text="No phone linked" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Add a device to get started" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE70D;" Style="{StaticResource IconGlyph}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </ToggleButton>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;" VerticalAlignment="Top" Margin="4,0,0,0"
                                ToolTip="Add a device" Click="OpenPairingPanel_Click" AutomationProperties.Name="Add device" />

                        <Popup x:Name="DevicePickerPopup" PlacementTarget="{Binding ElementName=DevicePickerToggle}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-12"
                               IsOpen="{Binding IsChecked, ElementName=DevicePickerToggle, Mode=TwoWay}">
                            <Border Style="{StaticResource FlyoutBorder}" Width="320" Padding="6">
                                <StackPanel>
                                    <TextBlock Text="Your devices" Style="{StaticResource CaptionText}" Margin="10,6,0,6" />
                                    <ListBox x:Name="DevicesList" MaxHeight="280" SelectionChanged="DevicesList_SelectionChanged"
                                             AutomationProperties.Name="Paired devices">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="10,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE8EA;" Style="{StaticResource IconGlyph}" FontSize="18" />
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding BatteryStatusText}" Style="{StaticResource CaptionText}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Separator Margin="-6,6" />
                                    <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left" Click="OpenPairingPanel_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,12,0" />
                                            <TextBlock Text="Add a device" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left" Click="RefreshDevices_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,12,0" />
                                            <TextBlock Text="Refresh device list" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Battery and sync status of the selected phone. -->
                    <Grid Style="{StaticResource DeviceSelected}" Margin="6,10,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" ToolTip="Battery">
                            <TextBlock Text="{Binding SelectedItem.BatteryGlyph, ElementName=DevicesList}" Style="{StaticResource IconGlyph}"
                                       FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding SelectedItem.BatteryDisplayText, ElementName=DevicesList}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" ToolTip="Last sync">
                            <TextBlock Text="&#xE895;" Style="{StaticResource IconGlyph}" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding SelectedItem.LastSeenText, ElementName=DevicesList}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Quick actions -->
                    <Grid Margin="0,12,-6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource QuickActionButton}" Click="StartMirror_Click"
                                ToolTip="Open your phone's screen in a window" AutomationProperties.Name="Open phone screen">
                            <StackPanel>
                                <TextBlock Text="&#xEE64;" Style="{StaticResource QuickActionGlyph}" />
                                <TextBlock Text="Screen" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource QuickActionButton}" Click="SendFiles_Click"
                                ToolTip="Send files to this phone's Downloads folder. You can also drop files on this window."
                                AutomationProperties.Name="Send files">
                            <StackPanel>
                                <TextBlock Text="&#xE898;" Style="{StaticResource QuickActionGlyph}" />
                                <TextBlock Text="Files" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource QuickActionButton}" Click="PublishClipboard_Click"
                                ToolTip="Send the text from Settings &gt; Clipboard to all phones" AutomationProperties.Name="Send clipboard">
                            <StackPanel>
                                <TextBlock Text="&#xE77F;" Style="{StaticResource QuickActionGlyph}" />
                                <TextBlock Text="Clipboard" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource QuickActionButton}" Click="RefreshPhoneData_Click"
                                ToolTip="Refresh phone data" AutomationProperties.Name="Refresh phone data">
                            <StackPanel>
                                <TextBlock Text="&#xE72C;" Style="{StaticResource QuickActionGlyph}" />
                                <TextBlock Text="Sync" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Now playing -->
            <Border x:Name="NowPlayingCard" Grid.Row="1" Style="{StaticResource PageCard}" Padding="12" Margin="0,8,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="6" Background="{DynamicResource ControlFillBrush}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyph}" FontSize="18"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Image x:Name="NowPlayingArt" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NowPlayingTitle" FontWeight="SemiBold" />
                            <TextBlock x:Name="NowPlayingArtist" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            <TextBlock x:Name="NowPlayingApp" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                    <Slider x:Name="NowPlayingProgress" Margin="0,8,0,0" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                            AutomationProperties.Name="Playback position"
                            PreviewMouseLeftButtonDown="NowPlayingProgress_DragStarted"
                            PreviewMouseLeftButtonUp="NowPlayingProgress_DragCompleted" />
                    <Grid>
                        <TextBlock x:Name="NowPlayingElapsed" Style="{StaticResource CaptionText}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="NowPlayingDuration" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="NowPlayingPrevious" Content="&#xE892;" Style="{StaticResource IconButton}" Tag="previous"
                                    ToolTip="Previous" AutomationProperties.Name="Previous track" Click="NowPlayingCommand_Click" />
                            <Button x:Name="NowPlayingPlayPause" Content="&#xE768;" Style="{StaticResource IconButton}" Tag="toggle"
                                    Width="36" Height="36" FontSize="18" Margin="6,0"
                                    ToolTip="Play or pause" AutomationProperties.Name="Play or pause" Click="NowPlayingCommand_Click" />
                            <Button x:Name="NowPlayingNext" Content="&#xE893;" Style="{StaticResource IconButton}" Tag="next"
                                    ToolTip="Next" AutomationProperties.Name="Next track" Click="NowPlayingCommand_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notifications header -->
            <Grid Grid.Row="2" Margin="4,18,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="NotificationStatusText" Text="Select a phone to view notifications." Style="{StaticResource CaptionText}"
                               Margin="0,1,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <ToggleButton x:Name="NotificationFilterToggle" Grid.Column="1" Style="{StaticResource IconToggleButton}" Content="&#xE71C;"
                              IsHitTestVisible="{Binding IsOpen, ElementName=NotificationFilterPopup, Converter={StaticResource InverseBool}}"
                              ToolTip="Search and filter notifications" AutomationProperties.Name="Filter notifications" />
                <Button Grid.Column="2" Content="Clear all" Style="{StaticResource TextLinkButton}" Click="ClearNotifications_Click"
                        ToolTip="Clear notifications from this PC" />
                <Popup x:Name="NotificationFilterPopup" PlacementTarget="{Binding ElementName=NotificationFilterToggle}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-264"
                       IsOpen="{Binding IsChecked, ElementName=NotificationFilterToggle, Mode=TwoWay}">
                    <Border Style="{StaticResource FlyoutBorder}" Width="300" Padding="12">
                        <StackPanel>
                            <TextBox x:Name="NotificationSearchBox" controls:Fluent.Placeholder="Search notifications" controls:Fluent.Icon="&#xE721;"
                                     AutomationProperties.Name="Search notifications" TextChanged="NotificationSearchBox_TextChanged" />
                            <ComboBox x:Name="NotificationAppFilter" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                      SelectionChanged="NotificationAppFilter_SelectionChanged" AutomationProperties.Name="Filter by app" />
                            <CheckBox x:Name="HideMutedNotificationsCheck" Content="Hide muted apps" IsChecked="True" Margin="0,8,0,0"
                                      Checked="HideMutedNotificationsCheck_Changed" Unchecked="HideMutedNotificationsCheck_Changed" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Notification feed -->
            <Grid Grid.Row="3">
                <StackPanel x:Name="NotificationsEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock Text="&#xEA8F;" Style="{StaticResource EmptyStateGlyph}" FontSize="32" />
                    <TextBlock Text="You're all caught up" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                    <TextBlock Text="New notifications from your phone appear here." Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <ListView x:Name="NotificationsList" ItemContainerStyle="{StaticResource PlainListItem}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Notifications">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="4,8,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Style="{StaticResource PageCard}" Padding="12,10,8,12" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- App header row: icon, name and time; actions appear on hover. -->
                                    <Grid Height="28">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="16" Height="16" Margin="0,0,8,0">
                                            <Border x:Name="AppInitialsBadge" CornerRadius="4" Background="{DynamicResource AccentSubtleBrush}">
                                                <TextBlock Text="{Binding AppInitials}" FontSize="8" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image x:Name="AppIconImage" Source="{Binding AppIcon}" Visibility="Collapsed" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AppName}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text=" · " Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding PostedAt.LocalDateTime, StringFormat={}{0:t}}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Visibility="Hidden">
                                            <Button Content="&#xE7ED;" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13"
                                                    ToolTip="Mute this app on this PC" AutomationProperties.Name="Mute app" Click="MuteNotificationApp_Click" />
                                            <Button Content="&#xE711;" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                                    ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification" Click="DismissNotification_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,4,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ImageAvatar" Width="32" Height="32" CornerRadius="16" ClipToBounds="True"
                                                VerticalAlignment="Top" Margin="0,2,10,0" Visibility="Collapsed">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding LargeIcon}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock x:Name="NotificationBodyText" Text="{Binding Body}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" MaxHeight="58" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Margin="0,0,4,0">
                                        <Border x:Name="NotificationPictureBorder" MaxHeight="180" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Visibility="Collapsed">
                                            <Image Source="{Binding Picture}" Stretch="Uniform" controls:Fluent.ClipRadius="6" />
                                        </Border>
                                        <Button Content="{Binding ExpandButtonText}" Style="{StaticResource TextLinkButton}" HorizontalAlignment="Left"
                                                FontSize="12" Margin="-8,2,0,0" Click="ToggleNotificationExpanded_Click"
                                                Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisConverter}}" />
                                        <Grid Margin="0,4,0,0" Visibility="{Binding CanReply, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ReplyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     controls:Fluent.Placeholder="Reply" AutomationProperties.Name="Notification reply" />
                                            <Button Grid.Column="1" Content="&#xE724;" Style="{StaticResource AccentButton}" Width="32" Padding="0"
                                                    FontFamily="{StaticResource IconFontFamily}" Margin="6,0,0,0"
                                                    ToolTip="Send reply" AutomationProperties.Name="Send reply" Click="InlineNotificationReply_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger SourceName="Card" Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <DataTrigger Binding="{Binding HasAppIcon}" Value="True">
                                    <Setter TargetName="AppIconImage" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="AppInitialsBadge" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasLargeIcon}" Value="True">
                                    <Setter TargetName="ImageAvatar" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasPicture}" Value="True">
                                    <Setter TargetName="NotificationPictureBorder" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter TargetName="NotificationBodyText" Property="MaxHeight" Value="1000" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Status line for transient messages from any page. -->
            <Grid Grid.Row="4" Margin="4,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}" FontSize="12" VerticalAlignment="Top" Margin="0,2,8,0"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting Smartphone Link..." Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" MaxHeight="34" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
        </Grid>

        <!-- Content layer: the selected feature page. -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ContentLayer}">
            <TabControl x:Name="MainTabs" SelectedIndex="0" Style="{StaticResource ContentOnlyTabControl}" SelectionChanged="TabControl_SelectionChanged">
                <!-- Messages -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Conversation list -->
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                            <Grid Margin="16,20,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Messages" Style="{StaticResource PaneHeader}" />
                                        <TextBlock x:Name="SmsStatusText" Text="Select a phone to view messages." Style="{StaticResource CaptionText}"
                                                   Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72C;" VerticalAlignment="Top"
                                            ToolTip="Refresh messages" AutomationProperties.Name="Refresh messages" Click="RefreshPhoneData_Click" />
                                </Grid>
                                <TextBox x:Name="SmsSearchBox" Grid.Row="1" Margin="0,14,0,8" controls:Fluent.Placeholder="Search conversations"
                                         controls:Fluent.Icon="&#xE721;" AutomationProperties.Name="Search conversations"
                                         TextChanged="SmsSearchBox_TextChanged" />
                                <TextBlock Grid.Row="2" Text="No conversations yet" HorizontalAlignment="Center" Margin="0,24,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=SmsThreadsList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox x:Name="SmsThreadsList" Grid.Row="2" SelectionChanged="SmsThreadsList_SelectionChanged"
                                         AutomationProperties.Name="Conversations">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Avatar}" Width="40" Height="40" CornerRadius="20">
                                                    <TextBlock Text="{Binding Initials}" Style="{StaticResource AvatarInitials}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ThreadName" Text="{Binding DisplayName}" />
                                                    <TextBlock x:Name="ThreadSnippet" Text="{Binding Snippet}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding UpdatedAt.LocalDateTime, StringFormat={}{0:t}}" Style="{StaticResource CaptionText}"
                                                               HorizontalAlignment="Right" />
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                                            Margin="0,4,0,0" HorizontalAlignment="Right"
                                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="{Binding UnreadCount}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                    <Setter TargetName="ThreadName" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="ThreadSnippet" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Conversation -->
                        <Grid Grid.Column="1">
                            <StackPanel Style="{StaticResource NoThreadSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource EmptyStateGlyph}" />
                                <TextBlock Text="Pick a conversation" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Your phone's text messages show up here. Choose one on the left to read and reply."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>

                            <Grid Style="{StaticResource ThreadSelected}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Avatar}">
                                            <TextBlock Text="{Binding SelectedItem.Initials, ElementName=SmsThreadsList}" Style="{StaticResource AvatarInitials}" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedItem.DisplayName, ElementName=SmsThreadsList}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedItem.Address, ElementName=SmsThreadsList}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="SmsMessagesList" Grid.Row="1" Padding="20,12" ItemContainerStyle="{StaticResource PlainListItem}"
                                         AutomationProperties.Name="Messages in conversation">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Border x:Name="Bubble" MaxWidth="480" HorizontalAlignment="Left" Padding="12,8,12,7"
                                                        CornerRadius="8,8,8,2" Background="{DynamicResource CardFillBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="MessageBody" Text="{Binding Body}" TextWrapping="Wrap" TextTrimming="None" />
                                                        <TextBlock x:Name="MessageTime" Text="{Binding SentAt.LocalDateTime, StringFormat={}{0:t}}"
                                                                   Style="{StaticResource CaptionText}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding FromMe}" Value="True">
                                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                                                    <Setter TargetName="Bubble" Property="CornerRadius" Value="8,8,2,8" />
                                                    <Setter TargetName="MessageBody" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                    <Setter TargetName="MessageTime" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                    <Setter TargetName="MessageTime" Property="Opacity" Value="0.75" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Grid.Row="2" Margin="20,8,20,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SmsReplyText" MinHeight="36" MaxHeight="140" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" controls:Fluent.Placeholder="Enter a message"
                                             AutomationProperties.Name="Message text" />
                                    <Button Grid.Column="1" Style="{StaticResource AccentIconButton}" Content="&#xE724;" Margin="8,0,0,0"
                                            VerticalAlignment="Bottom" ToolTip="Send" AutomationProperties.Name="Send message" Click="QueueSms_Click" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Photos -->
                <TabItem>
                    <Grid Margin="24,20,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Photos" Style="{StaticResource PaneHeader}" />
                                <TextBlock x:Name="PhotosStatusText" Text="Select a phone to browse photos." Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PhotoSelectionText" Text="0 selected" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SaveSelectedPhotos_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Save" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AccentButton}" Click="OpenSelectedPhoto_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                        <TextBlock Text="Open" Foreground="{DynamicResource AccentTextBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="360" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PhotoSearchBox" controls:Fluent.Placeholder="Search photos" controls:Fluent.Icon="&#xE721;"
                                     AutomationProperties.Name="Search photos" TextChanged="PhotoSearchBox_TextChanged" />
                            <ComboBox x:Name="PhotoAlbumFilter" Grid.Column="1" Width="170" Margin="8,0,0,0"
                                      SelectionChanged="PhotoAlbumFilter_SelectionChanged" AutomationProperties.Name="Filter by album" />
                            <ComboBox x:Name="PhotoSortCombo" Grid.Column="2" Width="150" Margin="8,0,0,0" SelectedIndex="0"
                                      SelectionChanged="PhotoSortCombo_SelectionChanged" AutomationProperties.Name="Photo sort order">
                                <ComboBoxItem Content="Newest first" Tag="newest" />
                                <ComboBoxItem Content="Oldest first" Tag="oldest" />
                                <ComboBoxItem Content="Largest first" Tag="largest" />
                                <ComboBoxItem Content="File name" Tag="name" />
                            </ComboBox>
                            <ComboBox x:Name="PhotoTileSizeCombo" Grid.Column="3" Width="120" Margin="8,0,0,0" SelectedIndex="1"
                                      SelectionChanged="PhotoTileSizeCombo_SelectionChanged" AutomationProperties.Name="Photo tile size">
                                <ComboBoxItem Content="Small" Tag="136" />
                                <ComboBoxItem Content="Medium" Tag="176" />
                                <ComboBoxItem Content="Large" Tag="220" />
                            </ComboBox>
                        </Grid>
                        <ListView x:Name="PhotosList" Grid.Row="2" Margin="-3,0,-12,0" SelectionMode="Extended"
                                  ItemContainerStyle="{StaticResource TileListItem}"
                                  MouseDoubleClick="PhotosList_MouseDoubleClick" SelectionChanged="PhotosList_SelectionChanged"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                                  ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Photos">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingWrapPanel ItemSize="176" Loaded="PhotoGridPanel_Loaded" Margin="0,0,12,0" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="Tile" ToolTip="{Binding FileName}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open" Click="OpenPhotoInline_Click">
                                                    <MenuItem.Icon><TextBlock Text="&#xE8A7;" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Save to PC..." Click="SavePhotoInline_Click">
                                                    <MenuItem.Icon><TextBlock Text="&#xE74E;" /></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Border CornerRadius="6" Background="{DynamicResource ControlFillBrush}" Margin="2">
                                            <TextBlock Text="&#xEB9F;" Style="{StaticResource IconGlyph}" FontSize="22"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                        <!-- An image brush crops to the square tile from the centre and follows the rounded corners. -->
                                        <Border CornerRadius="6" Margin="2">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="Caption" CornerRadius="0,0,6,6" Margin="2" VerticalAlignment="Bottom" Padding="8,14,8,6"
                                                Visibility="Hidden">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#00000000" />
                                                    <GradientStop Offset="1" Color="#B0000000" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TakenAt.LocalDateTime, StringFormat={}{0:d MMM yyyy, HH:mm}}"
                                                           Foreground="#D0FFFFFF" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Caption" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- Files -->
                <TabItem>
                    <Grid Margin="24,20,24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Files" Style="{StaticResource PaneHeader}" />
                            <TextBlock x:Name="StorageStatusText" Text="Select a phone to browse its files." Style="{StaticResource CaptionText}"
                                       Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                        <!-- Command bar -->
                        <Grid Grid.Row="1" Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back" AutomationProperties.Name="Go back"
                                    Click="StorageGoBack_Click" />
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="6,0,12,0">
                                <ItemsControl ItemsSource="{Binding Breadcrumbs, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding Name}" Style="{StaticResource SubtleButton}" FontSize="16" Padding="6,2"
                                                        Click="Breadcrumb_Click" />
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource IconGlyph}" FontSize="10" Margin="2,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBox x:Name="StorageSearchBox" Grid.Column="2" controls:Fluent.Placeholder="Search this folder"
                                     controls:Fluent.Icon="&#xE721;" AutomationProperties.Name="Search files" TextChanged="StorageSearchBox_TextChanged" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DownloadStorageFile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Download" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}" Click="DeleteStorageItem_Click" AutomationProperties.Name="Delete">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="Delete" Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- Column header -->
                        <Grid Grid.Row="2" Margin="12,0,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource CaptionText}" Margin="40,0,0,0" />
                            <TextBlock Grid.Column="1" Text="Details" Style="{StaticResource CaptionText}" />
                        </Grid>
                        <Border Grid.Row="3" Style="{StaticResource PageCard}" Padding="4">
                            <ListBox x:Name="StorageItemsList" MouseDoubleClick="StorageItemsList_MouseDoubleClick" AutomationProperties.Name="Files">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,7">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open" Click="StorageOpenMenuItem_Click">
                                                        <MenuItem.Icon><TextBlock Text="&#xE8E5;" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Download to..." Click="StorageDownloadMenuItem_Click"
                                                              Visibility="{Binding IsFile, Converter={StaticResource BoolToVisConverter}}">
                                                        <MenuItem.Icon><TextBlock Text="&#xE896;" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Delete" Click="StorageDeleteMenuItem_Click" Foreground="{DynamicResource DangerBrush}">
                                                        <MenuItem.Icon><TextBlock Text="&#xE74D;" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FileGlyph" Text="&#xE7C3;" Style="{StaticResource IconGlyph}" FontSize="18"
                                                       HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Details}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IconType}" Value="Folder">
                                                <Setter TargetName="FileGlyph" Property="Text" Value="&#xE8B7;" />
                                                <Setter TargetName="FileGlyph" Property="Foreground" Value="{DynamicResource CautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IconType}" Value="Image"><Setter TargetName="FileGlyph" Property="Text" Value="&#xEB9F;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconType}" Value="Audio"><Setter TargetName="FileGlyph" Property="Text" Value="&#xE8D6;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconType}" Value="Video"><Setter TargetName="FileGlyph" Property="Text" Value="&#xE8B2;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconType}" Value="Document"><Setter TargetName="FileGlyph" Property="Text" Value="&#xE8A5;" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Apps -->
                <TabItem>
                    <Grid Margin="24,20,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Apps" Style="{StaticResource PaneHeader}" />
                                <TextBlock x:Name="AppsStatusText" Text="Select a phone to see its apps." Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="0,0,8,0" ToolTip="Refresh apps"
                                        AutomationProperties.Name="Refresh apps" Click="RefreshApps_Click" />
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenAppWindow_Click"
                                        ToolTip="Run the selected app in its own PC window, separate from the phone screen. Needs wireless debugging.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Open in window" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AccentButton}" Click="StartMirror_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEE64;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                        <TextBlock Text="Open phone screen" Foreground="{DynamicResource AccentTextBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="AppsSearchBox" Grid.Row="1" Margin="0,16,0,12" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                                 controls:Fluent.Placeholder="Search apps" controls:Fluent.Icon="&#xE721;"
                                 TextChanged="AppsSearchBox_TextChanged" AutomationProperties.Name="Search apps" />
                        <ListBox x:Name="AppsList" Grid.Row="2" Margin="-3,0,-12,0" ItemContainerStyle="{StaticResource TileListItem}"
                                 MouseDoubleClick="AppsList_MouseDoubleClick" KeyDown="AppsList_KeyDown" AutomationProperties.Name="Phone apps">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Margin="0,0,12,16" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="104" Margin="4,12,4,10" ToolTip="{Binding Label}">
                                        <Image Source="{Binding Icon}" Width="48" Height="48" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" TextAlignment="Center" FontSize="12" Margin="0,8,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- Settings -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="16,20,8,0">
                            <TextBlock Text="Settings" Style="{StaticResource PaneHeader}" Margin="4,0,0,16" />
                            <RadioButton GroupName="SettingsNavigation" AutomationProperties.Name="General settings" Tag="0" IsChecked="True" Style="{StaticResource SettingsNavButton}"
                                         Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" Margin="0,0,14,0" />
                                    <TextBlock Text="General" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="SettingsNavigation" AutomationProperties.Name="Devices settings" Tag="1" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EA;" Style="{StaticResource IconGlyph}" Margin="0,0,14,0" />
                                    <TextBlock Text="Devices" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="SettingsNavigation" AutomationProperties.Name="Phone screen settings" Tag="2" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEE64;" Style="{StaticResource IconGlyph}" Margin="0,0,14,0" />
                                    <TextBlock Text="Phone screen" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="SettingsNavigation" AutomationProperties.Name="Clipboard settings" Tag="3" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77F;" Style="{StaticResource IconGlyph}" Margin="0,0,14,0" />
                                    <TextBlock Text="Clipboard" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DiagnosticsSettingsNav" GroupName="SettingsNavigation" AutomationProperties.Name="Diagnostics settings" Tag="4" Style="{StaticResource SettingsNavButton}"
                                         Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource IconGlyph}" Margin="0,0,14,0" />
                                    <TextBlock Text="Diagnostics" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TabControl x:Name="SettingsTabs" Grid.Column="1" SelectedIndex="0" Style="{StaticResource ContentOnlyTabControl}">
                            <!-- General -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,20,32,32" MaxWidth="1000">
                                        <TextBlock Text="General" Style="{StaticResource PageTitle}" Margin="0,0,0,8" />
                                        <TextBlock Text="App behavior" Style="{StaticResource SettingsGroupHeader}" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE7E8;" Style="{StaticResource SettingsCardGlyph}" />
                                                <CheckBox x:Name="MinimizeToTrayCheck" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                                          DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          AutomationProperties.Name="Keep running in the notification area"
                                                          Checked="MinimizeToTrayCheck_Changed" Unchecked="MinimizeToTrayCheck_Changed" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Keep running in the notification area" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="Keeps paired phones connected after this window closes." Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE7B5;" Style="{StaticResource SettingsCardGlyph}" />
                                                <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource ToggleSwitch}"
                                                          DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          AutomationProperties.Name="Start when I sign in to Windows"
                                                          Checked="StartWithWindowsCheck_Changed" Unchecked="StartWithWindowsCheck_Changed" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Start Smartphone Link when I sign in to Windows" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock x:Name="StartupRegistrationStatusText"
                                                               Text="Startup will be enabled automatically after the first successful pairing."
                                                               Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="Updates" Style="{StaticResource SettingsGroupHeader}" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE895;" Style="{StaticResource SettingsCardGlyph}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="AppVersionText" Text="Smartphone Link" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="Updates are installed by the Microsoft Store."
                                                               Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="Privacy" Style="{StaticResource SettingsGroupHeader}" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE72E;" Style="{StaticResource SettingsCardGlyph}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Your data stays with your devices" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="Clipboard contents are held only for delivery. Photos, messages, and notifications stay scoped to the selected phone."
                                                               Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE7ED;" Style="{StaticResource SettingsCardGlyph}" />
                                                <Button Content="Restore" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"
                                                        VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="96" Click="ClearMutedNotificationApps_Click" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Muted notification apps" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="Show notifications again from every app you muted on this PC." Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Devices -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,20,32,32" MaxWidth="1000">
                                        <TextBlock Text="Devices" Style="{StaticResource PageTitle}" Margin="0,0,0,8" />
                                        <TextBlock Text="Selected phone" Style="{StaticResource SettingsGroupHeader}" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE8EA;" Style="{StaticResource SettingsCardGlyph}" />
                                                <Button Style="{StaticResource DangerButton}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                                        Click="RevokeSelected_Click" Content="Forget phone" />
                                                <StackPanel VerticalAlignment="Center" Style="{StaticResource DeviceSelected}">
                                                    <TextBlock Text="{Binding SelectedItem.DisplayName, ElementName=DevicesList}" Style="{StaticResource SettingsCardTitle}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding SelectedItem.StatusText, ElementName=DevicesList}" Style="{StaticResource CaptionText}" />
                                                        <TextBlock Text=" · Battery " Style="{StaticResource CaptionText}" />
                                                        <TextBlock Text="{Binding SelectedItem.BatteryDisplayText, ElementName=DevicesList}" Style="{StaticResource CaptionText}" />
                                                        <TextBlock Text=" · Last sync " Style="{StaticResource CaptionText}" />
                                                        <TextBlock Text="{Binding SelectedItem.LastSeenText, ElementName=DevicesList}" Style="{StaticResource CaptionText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center" Style="{StaticResource NoDeviceSelected}">
                                                    <TextBlock Text="No phone selected" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="Pick a phone from the phone card, or add one below." Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="Pairing" Style="{StaticResource SettingsGroupHeader}" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE710;" Style="{StaticResource SettingsCardGlyph}" />
                                                <Button Content="Add device" Style="{StaticResource AccentButton}" DockPanel.Dock="Right"
                                                        VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="110" Click="OpenPairingPanel_Click" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Add a device" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="Pair an Android phone once with a short code. It reconnects automatically afterwards."
                                                               Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE8D7;" Style="{StaticResource SettingsCardGlyph}" />
                                                <Button Content="Repair" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"
                                                        VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="96" Click="RepairTrustStore_Click" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Trusted-device storage" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="{Binding Text, ElementName=TrustStoreStatusText}" Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Phone screen -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,20,32,32" MaxWidth="1000">
                                        <TextBlock Text="Phone screen" Style="{StaticResource PageTitle}" Margin="0,0,0,8" />
                                        <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,4">
                                            <DockPanel>
                                                <TextBlock Text="&#xEE64;" Style="{StaticResource SettingsCardGlyph}" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <Button Content="Stop" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" MinWidth="72"
                                                            Click="StopMirror_Click" />
                                                    <Button Content="Open phone screen" Style="{StaticResource AccentButton}" Click="StartMirror_Click" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Use your phone from this PC" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock x:Name="MirrorStatusText" Text="Select a connected phone to start."
                                                               Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="Quality" Style="{StaticResource SettingsGroupHeader}" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xEC4A;" Style="{StaticResource SettingsCardGlyph}" />
                                                <ComboBox x:Name="MirrorProfileCombo" Width="200" SelectedIndex="0"
                                                          DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          SelectionChanged="MirrorProfileCombo_SelectionChanged" AutomationProperties.Name="Performance">
                                                    <ComboBoxItem Content="Auto (recommended)" Tag="auto" />
                                                    <ComboBoxItem Content="Balanced" Tag="balanced" />
                                                    <ComboBoxItem Content="Sharpness" Tag="sharpness" />
                                                    <ComboBoxItem Content="Low latency" Tag="low-latency" />
                                                </ComboBox>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Performance" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="Presets for resolution and frame rate." Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE7F4;" Style="{StaticResource SettingsCardGlyph}" />
                                                <ComboBox x:Name="MirrorResolutionCombo" Width="200" SelectedIndex="1" DockPanel.Dock="Right"
                                                          VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Resolution">
                                                    <ComboBoxItem Content="720p" Tag="1280x720" />
                                                    <ComboBoxItem Content="1080p" Tag="1080x1920" />
                                                    <ComboBoxItem Content="1440p" Tag="1440x2560" />
                                                    <ComboBoxItem Content="Native" Tag="0x0" />
                                                </ComboBox>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Resolution" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="Higher is sharper but needs a faster network." Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE916;" Style="{StaticResource SettingsCardGlyph}" />
                                                <ComboBox x:Name="MirrorFpsCombo" Width="200" SelectedIndex="2" DockPanel.Dock="Right"
                                                          VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="Frame rate">
                                                    <ComboBoxItem Content="15 fps" Tag="15" />
                                                    <ComboBoxItem Content="30 fps" Tag="30" />
                                                    <ComboBoxItem Content="60 fps" Tag="60" />
                                                </ComboBox>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Frame rate" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="Audio is optional and never reduces video responsiveness." Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="Connection" Style="{StaticResource SettingsGroupHeader}" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE701;" Style="{StaticResource SettingsCardGlyph}" />
                                                <CheckBox x:Name="MirrorUseAdbCheck" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                                          DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                                          AutomationProperties.Name="Use wireless debugging when the phone has it on" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Use wireless debugging when the phone has it on" Style="{StaticResource SettingsCardTitle}" />
                                                    <TextBlock Text="No screen-capture prompt, exact touch and keyboard input, and it keeps working with the phone's screen off. Falls back to the app automatically."
                                                               Style="{StaticResource SettingsCardDescription}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource InfoBar}" Margin="0,12,0,0">
                                            <DockPanel>
                                                <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Top" Margin="0,1,12,0" DockPanel.Dock="Left" />
                                                <TextBlock Text="Android may request screen-capture approval when a new projection session starts. Reconnecting to an active session does not require pairing again."
                                                           Style="{StaticResource BodyText}" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Clipboard -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,20,32,32" MaxWidth="1000">
                                        <TextBlock Text="Clipboard" Style="{StaticResource PageTitle}" Margin="0,0,0,8" />
                                        <Border Style="{StaticResource InfoBar}" Margin="0,12,0,4">
                                            <DockPanel>
                                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource SuccessBrush}"
                                                           VerticalAlignment="Top" Margin="0,1,12,0" DockPanel.Dock="Left" />
                                                <TextBlock Text="Copy once, paste on every connected device. PC clipboard changes are detected instantly and relayed to all online phones."
                                                           Style="{StaticResource BodyText}" />
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="Share text" Style="{StaticResource SettingsGroupHeader}" />
                                        <Border Style="{StaticResource PageCard}">
                                            <StackPanel>
                                                <TextBox x:Name="ClipboardText" MinHeight="160" AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                                         controls:Fluent.Placeholder="Type or paste text to send to your phones"
                                                         AutomationProperties.Name="Clipboard text" />
                                                <DockPanel Margin="0,12,0,0">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <Button Content="Read PC clipboard" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                                                Click="ReadClipboard_Click" />
                                                        <Button Content="Send to all devices" Style="{StaticResource AccentButton}" Click="PublishClipboard_Click" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="ClipboardStatusText" Text="Waiting for a clipboard change." Style="{StaticResource CaptionText}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Diagnostics -->
                            <TabItem>
                                <Grid Margin="16,20,32,24" MaxWidth="1000">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Diagnostics" Style="{StaticResource PageTitle}" Margin="0,0,0,8" />
                                    <Border Grid.Row="1" Style="{StaticResource PageCard}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button Content="Refresh" Style="{StaticResource TextLinkButton}" DockPanel.Dock="Right"
                                                        Click="RefreshDiagnostics_Click" />
                                                <Button Content="Ask phone" Style="{StaticResource TextLinkButton}" DockPanel.Dock="Right"
                                                        Click="RequestDeviceDiagnostics_Click" Margin="0,0,4,0" />
                                                <TextBlock Text="&#xE9D9;" Style="{StaticResource IconGlyph}" DockPanel.Dock="Left" Margin="0,0,12,0" />
                                                <TextBlock Text="Link health" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock x:Name="DiagnosticsSummaryText" Text="Collecting..." Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                                            <TextBlock x:Name="DiagnosticsReasonsText" Text="" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <TextBlock x:Name="DiagnosticsSessionsText" Text="" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="Recent transport events" Style="{StaticResource SettingsGroupHeader}" />
                                    <Border Grid.Row="3" Style="{StaticResource PageCard}" Padding="12,8">
                                        <ListBox x:Name="DiagnosticsEventsList" ItemContainerStyle="{StaticResource PlainListItem}"
                                                 AutomationProperties.Name="Recent transport events">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition Width="68" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Time}" Style="{StaticResource CaptionText}" FontFamily="Cascadia Mono, Consolas" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource CaptionText}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Add-a-device dialog. Pairing is intentionally transient instead of a permanent page. -->
        <Grid x:Name="PairingOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="{DynamicResource SmokeBrush}"
              Visibility="Collapsed">
            <Border x:Name="PairingPanel" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="True"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FlyoutStrokeBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource OverlayRadius}" Effect="{StaticResource DialogShadow}"
                    AutomationProperties.Name="Add a device">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="24,22,24,20">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="Close"
                                    Margin="0,-6,-10,0" VerticalAlignment="Top" Click="ClosePairingPanel_Click" AutomationProperties.Name="Close add device dialog" />
                            <TextBlock Text="Add a device" Style="{StaticResource SubtitleText}" />
                        </DockPanel>
                        <TextBlock Text="Open Smartphone Link on your Android phone and enter the code below. You only need to pair once."
                                   Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                        <Border Style="{StaticResource PageCard}" Margin="0,20,0,0" Padding="16,20">
                            <StackPanel>
                                <controls:BrandMark Width="44" Height="44" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PairingCodeText" Text="No active code" FontFamily="Cascadia Mono, Consolas" FontSize="34"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                <TextBlock x:Name="PairingExpiryText" Text="Create a code when your phone is ready."
                                           Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Expander Header="Having trouble?" Margin="-8,14,0,0">
                            <StackPanel Margin="8,4,0,0">
                                <TextBlock Text="Trusted-device storage" FontWeight="SemiBold" />
                                <TextBlock x:Name="TrustStoreStatusText" Text="Checking trusted devices..." Style="{StaticResource BodyText}"
                                           FontSize="12" Margin="0,4,0,8" />
                                <Button Content="Repair from backup" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Click="RepairTrustStore_Click" />
                                <TextBlock Text="Pairing codes are only needed for new or explicitly forgotten devices."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <!-- Dialog footer -->
                    <Border Grid.Row="1" Background="{DynamicResource CardFillSecondaryBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CreatePairingCodeButton" Content="Create pairing code" Style="{StaticResource AccentButton}"
                                    Click="CreatePairingTicket_Click" />
                            <Button Grid.Column="2" Content="Close" Click="ClosePairingPanel_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
