<mirror:MirrorOverlayWindow x:Class="Pairly.Windows.Mirror.MirrorControlBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Pairly.Windows.Localization"
        xmlns:mirror="clr-namespace:Pairly.Windows.Mirror"
        Title="{l:Loc phone_screen}" SizeToContent="WidthAndHeight">
    <mirror:MirrorOverlayWindow.Resources>
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </mirror:MirrorOverlayWindow.Resources>

    <!-- The margin leaves room for the shadow inside the transparent window. -->
    <Border Margin="14,8,14,16" Padding="6,4" CornerRadius="22" BorderThickness="1"
            Background="{DynamicResource FlyoutBrush}" BorderBrush="{DynamicResource FlyoutStrokeBrush}"
            Effect="{StaticResource FlyoutShadow}">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BackButton" Style="{StaticResource PillButton}" Content="&#xE76B;"
                    ToolTip="{l:Loc action_back}" AutomationProperties.Name="{l:Loc phone_back}" />
            <Button x:Name="HomeButton" Style="{StaticResource PillButton}" Content="&#xEA3A;"
                    ToolTip="{l:Loc home}" AutomationProperties.Name="{l:Loc phone_home}" />
            <Button x:Name="RecentsButton" Style="{StaticResource PillButton}" Content="&#xE7C4;"
                    ToolTip="{l:Loc recent_apps}" AutomationProperties.Name="{l:Loc recent_apps}" />

            <StackPanel x:Name="VolumeGroup" Orientation="Horizontal" Visibility="Collapsed" Background="Transparent">
                <Rectangle Width="1" Height="20" Margin="5,0" Fill="{DynamicResource DividerBrush}" />
                <Button x:Name="VolumeButton" Style="{StaticResource PillButton}" Content="&#xE995;"
                        ToolTip="{l:Loc mute_phone_sound_on_this_pc}" AutomationProperties.Name="{l:Loc phone_sound_on_this_pc}" />
                <!-- Appears while the pointer is over the speaker; wheel over either adjusts it. -->
                <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="100" Value="100" SmallChange="5" LargeChange="10"
                        VerticalAlignment="Center" Margin="2,0,8,0" Focusable="False" IsMoveToPointEnabled="True"
                        Visibility="Collapsed" AutomationProperties.Name="{l:Loc phone_sound_volume_on_this_pc}" />
            </StackPanel>

            <Rectangle Width="1" Height="20" Margin="5,0" Fill="{DynamicResource DividerBrush}" />
            <Button x:Name="StopButton" Style="{StaticResource PillButton}" Content="&#xE71A;"
                    Foreground="{DynamicResource DangerBrush}"
                    ToolTip="{l:Loc stop_phone_screen}" AutomationProperties.Name="{l:Loc stop_phone_screen}" />
        </StackPanel>
    </Border>
</mirror:MirrorOverlayWindow>
