<mirror:MirrorOverlayWindow x:Class="Pairly.Windows.Mirror.MirrorTopBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Pairly.Windows.Localization"
        xmlns:controls="clr-namespace:Pairly.Windows.Controls"
        xmlns:mirror="clr-namespace:Pairly.Windows.Mirror"
        Title="{l:Loc phone_screen}" Height="44" Width="400">
    <mirror:MirrorOverlayWindow.Resources>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="BarToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </mirror:MirrorOverlayWindow.Resources>

    <!-- Corner radius matches the Windows 11 window corners it sits in. -->
    <Border x:Name="BarBorder" CornerRadius="8,8,0,0" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource FlyoutStrokeBrush}" Background="{DynamicResource FlyoutBrush}">
        <Grid Margin="10,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <controls:BrandMark Width="16" Height="16" Margin="0,0,10,0" />
                <TextBlock x:Name="DeviceNameText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="200" />
                <Ellipse x:Name="QualityDot" Width="7" Height="7" Margin="10,1,6,0" VerticalAlignment="Center"
                         Fill="{DynamicResource CautionBrush}" />
                <TextBlock x:Name="QualityText" Text="{l:Loc connecting}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="InfoToggle" Style="{StaticResource BarToggle}" Content="&#xE946;"
                              ToolTip="{l:Loc stream_details}" AutomationProperties.Name="{l:Loc stream_details}" />
                <ToggleButton x:Name="NavToggle" Style="{StaticResource BarToggle}" Content="&#xE8A0;"
                              ToolTip="{l:Loc mirror_hide_buttons}" AutomationProperties.Name="{l:Loc mirror_hide_buttons}" />
                <ToggleButton x:Name="PinToggle" Style="{StaticResource BarToggle}" Content="&#xE718;"
                              ToolTip="{l:Loc keep_on_top}" AutomationProperties.Name="{l:Loc keep_on_top}" />
                <Button x:Name="FitButton" Style="{StaticResource BarButton}" Content="&#xE9A6;"
                        ToolTip="{l:Loc fit_window_to_phone_screen}" AutomationProperties.Name="{l:Loc fit_window_to_phone_screen}" />
                <Button x:Name="FullScreenButton" Style="{StaticResource BarButton}" Content="&#xE740;"
                        ToolTip="{l:Loc enter_full_screen}" AutomationProperties.Name="{l:Loc full_screen}" />
                <Rectangle Width="1" Height="18" Margin="5,0" Fill="{DynamicResource DividerBrush}" />
                <Button x:Name="MinimizeButton" Style="{StaticResource BarButton}" Content="&#xE921;" FontSize="10"
                        ToolTip="{l:Loc minimize}" AutomationProperties.Name="{l:Loc minimize}" />
                <Button x:Name="CloseButton" Style="{StaticResource BarButton}" Content="&#xE8BB;" FontSize="10"
                        ToolTip="{l:Loc close}" AutomationProperties.Name="{l:Loc close}" />
            </StackPanel>

            <Popup x:Name="InfoPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=InfoToggle}" Placement="Bottom"
                   StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-12" VerticalOffset="4"
                   IsOpen="{Binding IsChecked, ElementName=InfoToggle}">
                <Border Style="{StaticResource FlyoutBorder}" Width="300" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="{l:Loc stream_details}" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="DetailsText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</mirror:MirrorOverlayWindow>
