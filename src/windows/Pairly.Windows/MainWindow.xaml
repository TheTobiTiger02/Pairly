                        <TextBlock x:Name="PairingStepText" Text="{l:Loc step_1_of_3}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Welcome (first run) -->
                    <StackPanel x:Name="OnboardingWelcomeStep" Grid.Row="1" Margin="28,22,28,24" Visibility="Collapsed">
                        <controls:BrandMark Width="64" Height="64" HorizontalAlignment="Left" />
                        <TextBlock Text="{l:Loc your_phone_on_your_pc}" FontSize="28" FontWeight="SemiBold" Margin="0,18,0,0" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{l:Loc pairly_connects_your_android_phone_to_this_p}" />
                        <TextBlock Text="{l:Loc language}" FontWeight="SemiBold" Margin="0,24,0,6" />
                        <ComboBox x:Name="OnboardingLanguageCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_SelectionChanged"
                                  AutomationProperties.Name="{l:Loc language}">
                            <ComboBoxItem Tag="" Content="{l:Loc use_windows_language}" />
                            <ComboBoxItem Tag="en" Content="English" />
                            <ComboBoxItem Tag="de" Content="Deutsch" />
                        </ComboBox>
                    </StackPanel>

                    <!-- What Pairly can do (first run) -->
                    <StackPanel x:Name="OnboardingFeaturesStep" Grid.Row="1" Margin="28,22,28,24" Visibility="Collapsed">
                        <TextBlock Text="{l:Loc what_you_can_do}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,16" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{l:Loc everything_stays_between_your_phone_and_this}" />
                        <UniformGrid Columns="2">
                            <DockPanel Margin="0,0,16,16">
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource SettingsCardGlyph}" Foreground="{DynamicResource AccentBrush}" />
                                <StackPanel>
                                    <TextBlock Text="{l:Loc messages}" Style="{StaticResource FeatureTileTitle}" />
                                    <TextBlock Text="{l:Loc read_and_reply_to_texts_with_your_keyboard}" Style="{StaticResource SettingsCardDescription}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,16,16">
                                <TextBlock Text="&#xEA8F;" Style="{StaticResource SettingsCardGlyph}" Foreground="{DynamicResource AccentBrush}" />
                                <StackPanel>
                                    <TextBlock Text="{l:Loc tour_notifications_title}" Style="{StaticResource FeatureTileTitle}" />
                                    <TextBlock Text="{l:Loc see_answer_and_dismiss_them_here}" Style="{StaticResource SettingsCardDescription}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,16,16">
                                <TextBlock Text="&#xEB9F;" Style="{StaticResource SettingsCardGlyph}" Foreground="{DynamicResource AccentBrush}" />
                                <StackPanel>
                                    <TextBlock Text="{l:Loc photos_and_files}" Style="{StaticResource FeatureTileTitle}" />
                                    <TextBlock Text="{l:Loc browse_your_phone_and_send_files_both_ways}" Style="{StaticResource SettingsCardDescription}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,16,16">
                                <TextBlock Text="&#xE77F;" Style="{StaticResource SettingsCardGlyph}" Foreground="{DynamicResource AccentBrush}" />
                                <StackPanel>
                                    <TextBlock Text="{l:Loc shared_clipboard}" Style="{StaticResource FeatureTileTitle}" />
                                    <TextBlock Text="{l:Loc copy_on_one_device_paste_on_the_other}" Style="{StaticResource SettingsCardDescription}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,16,16">
                                <TextBlock Text="&#xEE64;" Style="{StaticResource SettingsCardGlyph}" Foreground="{DynamicResource AccentBrush}" />
                                <StackPanel>
                                    <TextBlock Text="{l:Loc phone_screen}" Style="{StaticResource FeatureTileTitle}" />
                                    <TextBlock Text="{l:Loc mirror_and_control_your_phone_in_a_window}" Style="{StaticResource SettingsCardDescription}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,16,16">
                                <TextBlock Text="&#xE717;" Style="{StaticResource SettingsCardGlyph}" Foreground="{DynamicResource AccentBrush}" />
                                <StackPanel>
                                    <TextBlock Text="{l:Loc calls}" Style="{StaticResource FeatureTileTitle}" />
                                    <TextBlock Text="{l:Loc see_who_s_calling_and_answer_from_your_pc}" Style="{StaticResource SettingsCardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Step 1: get the Android app -->
                    <Grid x:Name="PairingGetAppStep" Grid.Row="1" Margin="28,22,28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="12" Padding="6" Width="196" Height="196">
                            <Image x:Name="InstallQrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"
                                   AutomationProperties.Name="{l:Loc qr_code_that_downloads_pairly_for_android}" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc install_pairly_on_your_phone}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{l:Loc point_your_android_phone_s_camera_at_the_cod}" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{l:Loc copy_link}" Style="{StaticResource SecondaryButton}" Click="CopyInstallLink_Click" />
                                <Button Content="{l:Loc open_release_page}" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OpenReleasePage_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Step 2: pair by QR or code -->
                    <StackPanel x:Name="PairingPairStep" Grid.Row="1" Margin="28,22,28,20" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Background="White" CornerRadius="12" Padding="6" Width="196" Height="196">
                                <Grid>
                                    <Image x:Name="PairingQrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"
                                           AutomationProperties.Name="{l:Loc qr_code_that_pairs_your_phone_with_this_pc}" />
                                    <TextBlock x:Name="PairingQrPlaceholder" Text="{l:Loc creating_code}" Foreground="#5F6368" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc scan_with_pairly}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="{l:Loc in_pairly_on_your_phone_tap_scan_qr_code_or}" />
                                <ItemsControl x:Name="PairingCodeDigits" Margin="0,12,0,0" Focusable="False"
                                              AutomationProperties.Name="{l:Loc pairing_code}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="36" Height="44" Margin="0,0,6,0" CornerRadius="8"
                                                    Background="{DynamicResource CardFillSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="24" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Height="4" Margin="0,14,0,0" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="PairingCountdownRemaining" Width="1*" />
                                        <ColumnDefinition x:Name="PairingCountdownElapsed" Width="0*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource DividerBrush}" />
                                    <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                </Grid>
                                <TextBlock x:Name="PairingExpiryText" Text="{l:Loc creating_a_pairing_code}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Margin="0,18,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource CardFillSecondaryBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="PairingWaitingText" Text="{l:Loc waiting_for_your_phone}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Expander Header="{l:Loc having_trouble}" Margin="-8,12,0,0">
                            <StackPanel Margin="8,4,0,0">
                                <TextBlock Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap"
                                           Text="{l:Loc keep_your_phone_and_this_pc_on_the_same_wi_f}" />
                                <TextBlock x:Name="PairingAddressesText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="{l:Loc trusted_device_storage}" FontWeight="SemiBold" Margin="0,14,0,0" />
                                <TextBlock x:Name="TrustStoreStatusText" Text="{l:Loc checking_trusted_devices}" Style="{StaticResource BodyText}"
                                           FontSize="12" Margin="0,4,0,8" />
                                <Button Content="{l:Loc repair_from_backup}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Click="RepairTrustStore_Click" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Preferences (first run) -->
                    <StackPanel x:Name="OnboardingPreferencesStep" Grid.Row="1" Margin="28,22,28,24" Visibility="Collapsed">
                        <TextBlock Text="{l:Loc make_it_yours}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,16" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{l:Loc you_can_change_all_of_this_later_in_settings}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <DockPanel>
                                <TextBlock Text="&#xE7B5;" Style="{StaticResource SettingsCardGlyph}" />
                                <CheckBox x:Name="OnboardingStartupCheck" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Margin="16,0,0,0" IsChecked="True" AutomationProperties.Name="{l:Loc start_pairly_when_i_sign_in_to_windows}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:Loc start_pairly_when_i_sign_in_to_windows}" Style="{StaticResource SettingsCardTitle}" />
                                    <TextBlock Text="{l:Loc your_phone_reconnects_without_you_opening_pa}" Style="{StaticResource SettingsCardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <DockPanel>
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource SettingsCardGlyph}" />
                                <CheckBox x:Name="OnboardingTrayCheck" Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Margin="16,0,0,0" IsChecked="True" AutomationProperties.Name="{l:Loc keep_running_in_the_notification_area}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:Loc keep_running_in_the_notification_area}" Style="{StaticResource SettingsCardTitle}" />
                                    <TextBlock Text="{l:Loc closing_the_window_keeps_your_phone_connecte}" Style="{StaticResource SettingsCardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <DockPanel>
                                <TextBlock Text="&#xE790;" Style="{StaticResource SettingsCardGlyph}" />
                                <ComboBox x:Name="OnboardingThemeCombo" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="180"
                                          SelectionChanged="ThemeCombo_SelectionChanged" AutomationProperties.Name="{l:Loc theme}">
                                    <ComboBoxItem Tag="System" Content="{l:Loc use_windows_setting}" />
                                    <ComboBoxItem Tag="Light" Content="{l:Loc light}" />
                                    <ComboBoxItem Tag="Dark" Content="{l:Loc dark}" />
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:Loc theme}" Style="{StaticResource SettingsCardTitle}" />
                                    <TextBlock Text="{l:Loc light_dark_or_the_same_as_windows}" Style="{StaticResource SettingsCardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <!-- Step 3: paired -->
                    <StackPanel x:Name="PairingDoneStep" Grid.Row="1" Margin="28,30,28,28" Visibility="Collapsed">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource SuccessBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" FontSize="28" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="PairingDoneTitle" Text="{l:Loc pairing_done_title}" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock x:Name="PairingDoneBody" Style="{StaticResource BodyText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" MaxWidth="420"
                                   Text="{l:Loc pairing_done_body}" />
                    </StackPanel>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="{DynamicResource CardFillSecondaryBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="28,16">
                        <DockPanel LastChildFill="False">
                            <Button x:Name="PairingBackButton" DockPanel.Dock="Left" Content="{l:Loc need_the_app}" Style="{StaticResource SubtleButton}"
                                    Click="PairingShowGetApp_Click" />
                            <Button x:Name="PairingPrimaryButton" DockPanel.Dock="Right" Content="{l:Loc action_have_app}" Style="{StaticResource AccentButton}"
                                    MinWidth="140" Click="PairingPrimary_Click" />
                            <Button x:Name="PairingSecondaryButton" DockPanel.Dock="Right" Content="{l:Loc action_close}" Margin="0,0,8,0" MinWidth="90"
                                    Click="PairingSecondary_Click" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- What's new, once after an update. -->
        <Grid x:Name="WhatsNewOverlay" Grid.RowSpan="2" Grid.ColumnSpan="3" Panel.ZIndex="25" Background="{DynamicResource SmokeBrush}"
              Visibility="Collapsed">
            <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FlyoutStrokeBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource OverlayRadius}" Effect="{StaticResource DialogShadow}" AutomationProperties.Name="{l:Loc what_s_new}">
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE735;" Style="{StaticResource IconGlyph}" FontSize="22" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <TextBlock x:Name="WhatsNewTitle" Text="{l:Loc what_s_new}" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,12" />
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="WhatsNewList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="2,8,12,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Content="{l:Loc got_it}" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" MinWidth="120" Margin="0,20,0,0"
                            Click="WhatsNewClose_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
