<Window x:Class="Pairly.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Pairly.Windows.Controls"
        xmlns:l="clr-namespace:Pairly.Windows.Localization"
        mc:Ignorable="d"
        Title="Pairly" Icon="Assets/Pairly.ico" Width="1320" Height="860" MinWidth="980" MinHeight="640"
        Style="{StaticResource {x:Type Window}}"
        SizeChanged="MainWindow_SizeChanged" AllowDrop="True" DragOver="MainWindow_DragOver" Drop="MainWindow_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <controls:InverseBooleanConverter x:Key="InverseBool" />

        <Style x:Key="TabGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style x:Key="TabLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style x:Key="PaneHeader" TargetType="TextBlock" BasedOn="{StaticResource SubtitleText}" />
        <Style x:Key="QuickActionGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,2,0,5" />
        </Style>
        <Style x:Key="SettingsCardGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Margin" Value="4,0,18,0" />
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style x:Key="SettingsCardTitle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsCardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="SettingsCardControl" TargetType="FrameworkElement">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style x:Key="EmptyStateGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Avatar" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        </Style>
        <Style x:Key="AvatarInitials" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Visible only while the bound list has no selection. -->
        <Style x:Key="NoThreadSelected" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=SmsThreadsList}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThreadSelected" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=SmsThreadsList}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NoDeviceSelected" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=DevicesList}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceSelected" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=DevicesList}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavPaneButton" TargetType="RadioButton" BasedOn="{StaticResource SettingsNavButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="NavGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="HomeTileButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="128" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="HomeTileGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,2,0,14" />
        </Style>
        <Style x:Key="HelpAnswer" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="FeatureTileTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavPaneColumn" Width="Auto" />
            <ColumnDefinition x:Name="SidePanelColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title bar: brand, tabs (top-tabs layout), host status, help, settings and caption buttons. -->
        <Grid Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" HorizontalAlignment="Left">
                <controls:BrandMark Width="18" Height="18" />
                <TextBlock x:Name="BrandTitleText" Text="Pairly" FontSize="12" Margin="12,0,0,1" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="TopTabsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" Visibility="Collapsed">
                <RadioButton x:Name="HomeTab" GroupName="MainNavigation" Tag="5" Style="{StaticResource TopTabButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc home}" ToolTip="{l:Loc home}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource TabGlyph}" />
                        <TextBlock x:Name="HomeTabLabel" Text="{l:Loc home}" Style="{StaticResource TabLabel}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="MessagesNav" GroupName="MainNavigation" Tag="0" Style="{StaticResource TopTabButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc messages}" ToolTip="{l:Loc messages}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BD;" Style="{StaticResource TabGlyph}" />
                        <TextBlock x:Name="MessagesTabLabel" Text="{l:Loc messages}" Style="{StaticResource TabLabel}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="MainNavigation" Tag="1" Style="{StaticResource TopTabButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc photos}" ToolTip="{l:Loc photos}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB9F;" Style="{StaticResource TabGlyph}" />
                        <TextBlock x:Name="PhotosTabLabel" Text="{l:Loc photos}" Style="{StaticResource TabLabel}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="MainNavigation" Tag="2" Style="{StaticResource TopTabButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc files}" ToolTip="{l:Loc files}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource TabGlyph}" />
                        <TextBlock x:Name="FilesTabLabel" Text="{l:Loc files}" Style="{StaticResource TabLabel}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="MainNavigation" Tag="3" Style="{StaticResource TopTabButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc apps}" ToolTip="{l:Loc apps}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71D;" Style="{StaticResource TabGlyph}" />
                        <TextBlock x:Name="AppsTabLabel" Text="{l:Loc apps}" Style="{StaticResource TabLabel}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border Style="{StaticResource StatusPill}" VerticalAlignment="Center" Margin="0,8,8,0"
                        ToolTip="{l:Loc connection_between_this_window_and_the_pairl}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RealtimeStatusDot" Width="6" Height="6" Fill="{DynamicResource CautionBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="RealtimeStatusText" Text="{l:Loc starting}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel x:Name="TopTabsActions" Orientation="Horizontal" Visibility="Collapsed">
                    <RadioButton x:Name="HelpTab" GroupName="MainNavigation" Tag="7" Style="{StaticResource TopTabButton}"
                                 Width="40" Padding="0" Margin="0,6,2,0" VerticalAlignment="Top" Checked="Navigate_Click"
                                 AutomationProperties.Name="{l:Loc help}" ToolTip="{l:Loc help}">
                        <TextBlock Text="&#xE897;" Style="{StaticResource TabGlyph}" />
                    </RadioButton>
                    <RadioButton x:Name="SettingsNav" GroupName="MainNavigation" Tag="4" Style="{StaticResource TopTabButton}"
                                 Width="40" Padding="0" Margin="0,6,6,0" VerticalAlignment="Top" Checked="Navigate_Click"
                                 AutomationProperties.Name="{l:Loc settings}" ToolTip="{l:Loc settings}">
                        <TextBlock Text="&#xE713;" Style="{StaticResource TabGlyph}" />
                    </RadioButton>
                </StackPanel>
                <controls:CaptionButtons />
            </StackPanel>
        </Grid>

        <!-- Navigation-pane layout: phone card on top, then every page. -->
        <Grid x:Name="NavPane" Grid.Row="1" Width="292" Margin="12,4,8,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="NavDeviceHost" Focusable="False" IsTabStop="False">
                <Border x:Name="DeviceCard" Style="{StaticResource PageCard}" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="DevicePickerToggle" Style="{StaticResource SubtleToggleButton}" Padding="6"
                                          IsHitTestVisible="{Binding IsOpen, ElementName=DevicePickerPopup, Converter={StaticResource InverseBool}}"
                                          AutomationProperties.Name="{l:Loc choose_phone}" ToolTip="{l:Loc choose_which_phone_to_use}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSubtleBrush}">
                                        <TextBlock Text="&#xE8EA;" Style="{StaticResource IconGlyph}" FontSize="20" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Style="{StaticResource DeviceSelected}">
                                            <TextBlock Text="{Binding SelectedItem.DisplayName, ElementName=DevicesList}"
                                                       FontSize="16" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{Binding SelectedItem.StatusBrush, ElementName=DevicesList}" />
                                                <TextBlock Text="{Binding SelectedItem.StatusText, ElementName=DevicesList}" Style="{StaticResource CaptionText}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource NoDeviceSelected}">
                                            <TextBlock Text="{l:Loc no_phone_linked}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{l:Loc add_a_device_to_get_started}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE70D;" Style="{StaticResource IconGlyph}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </ToggleButton>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;" VerticalAlignment="Top" Margin="4,0,0,0"
                                    ToolTip="{l:Loc add_a_device}" Click="OpenPairingPanel_Click" AutomationProperties.Name="{l:Loc add_device}" />

                            <Popup x:Name="DevicePickerPopup" PlacementTarget="{Binding ElementName=DevicePickerToggle}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-12"
                                   IsOpen="{Binding IsChecked, ElementName=DevicePickerToggle, Mode=TwoWay}">
                                <Border Style="{StaticResource FlyoutBorder}" Width="320" Padding="6">
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc your_devices}" Style="{StaticResource CaptionText}" Margin="10,6,0,6" />
                                        <ListBox x:Name="DevicesList" MaxHeight="280" SelectionChanged="DevicesList_SelectionChanged"
                                                 AutomationProperties.Name="{l:Loc paired_devices}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="10,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE8EA;" Style="{StaticResource IconGlyph}" FontSize="18" />
                                                        <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                            <TextBlock Text="{Binding DisplayName}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding BatteryStatusText}" Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Separator Margin="-6,6" />
                                        <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left" Click="OpenPairingPanel_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,12,0" />
                                                <TextBlock Text="{l:Loc add_a_device}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left" Click="RefreshDevices_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,12,0" />
                                                <TextBlock Text="{l:Loc refresh_device_list}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Battery and sync status of the selected phone. -->
                        <Grid Style="{StaticResource DeviceSelected}" Margin="6,10,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" ToolTip="{l:Loc battery}">
                                <TextBlock Text="{Binding SelectedItem.BatteryGlyph, ElementName=DevicesList}" Style="{StaticResource IconGlyph}"
                                           FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding SelectedItem.BatteryDisplayText, ElementName=DevicesList}" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" ToolTip="{l:Loc last_sync}">
                                <TextBlock Text="&#xE895;" Style="{StaticResource IconGlyph}" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding SelectedItem.LastSeenText, ElementName=DevicesList}" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Quick actions -->
                        <Grid x:Name="DeviceQuickActions" Margin="0,12,-6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource QuickActionButton}" Click="StartMirror_Click"
                                    ToolTip="{l:Loc open_your_phone_s_screen_in_a_window}" AutomationProperties.Name="{l:Loc open_phone_screen}">
                                <StackPanel>
                                    <TextBlock Text="&#xEE64;" Style="{StaticResource QuickActionGlyph}" />
                                    <TextBlock Text="{l:Loc screen}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource QuickActionButton}" Click="SendFiles_Click"
                                    ToolTip="{l:Loc send_files_to_this_phone_s_downloads_folder}"
                                    AutomationProperties.Name="{l:Loc send_files}">
                                <StackPanel>
                                    <TextBlock Text="&#xE898;" Style="{StaticResource QuickActionGlyph}" />
                                    <TextBlock Text="{l:Loc files}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource QuickActionButton}" Click="PublishClipboard_Click"
                                    ToolTip="{l:Loc send_the_text_from_settings_clipboard_to_all}" AutomationProperties.Name="{l:Loc send_clipboard}">
                                <StackPanel>
                                    <TextBlock Text="&#xE77F;" Style="{StaticResource QuickActionGlyph}" />
                                    <TextBlock Text="{l:Loc clipboard}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource QuickActionButton}" Click="RefreshPhoneData_Click"
                                    ToolTip="{l:Loc refresh_phone_data}" AutomationProperties.Name="{l:Loc refresh_phone_data}">
                                <StackPanel>
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource QuickActionGlyph}" />
                                    <TextBlock Text="{l:Loc sync}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </ContentControl>
            <StackPanel x:Name="NavItemsPanel" Grid.Row="1" Margin="0,14,0,0" KeyboardNavigation.TabNavigation="Once"
                        KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton x:Name="NavHome" GroupName="MainNavigation" Tag="5" IsChecked="True" Style="{StaticResource NavPaneButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc home}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource NavGlyph}" />
                        <TextBlock Text="{l:Loc home}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavMessages" GroupName="MainNavigation" Tag="0" Style="{StaticResource NavPaneButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc messages}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BD;" Style="{StaticResource NavGlyph}" />
                        <TextBlock Text="{l:Loc messages}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="MainNavigation" Tag="1" Style="{StaticResource NavPaneButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc photos}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB9F;" Style="{StaticResource NavGlyph}" />
                        <TextBlock Text="{l:Loc photos}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="MainNavigation" Tag="2" Style="{StaticResource NavPaneButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc files}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource NavGlyph}" />
                        <TextBlock Text="{l:Loc files}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="MainNavigation" Tag="3" Style="{StaticResource NavPaneButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc apps}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71D;" Style="{StaticResource NavGlyph}" />
                        <TextBlock Text="{l:Loc apps}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavNotifications" GroupName="MainNavigation" Tag="6" Style="{StaticResource NavPaneButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc tour_notifications_title}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" Style="{StaticResource NavGlyph}" />
                        <TextBlock Text="{l:Loc tour_notifications_title}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <StackPanel x:Name="NavFooterPanel" Grid.Row="2">
                <RadioButton x:Name="NavHelp" GroupName="MainNavigation" Tag="7" Style="{StaticResource NavPaneButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc help}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" Style="{StaticResource NavGlyph}" />
                        <TextBlock Text="{l:Loc help}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" GroupName="MainNavigation" Tag="4" Style="{StaticResource NavPaneButton}"
                             Checked="Navigate_Click" AutomationProperties.Name="{l:Loc settings}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource NavGlyph}" />
                        <TextBlock Text="{l:Loc settings}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>

        <!-- Top-tabs layout: the phone, now playing and notifications stay visible on the left. -->
        <Grid x:Name="SidePanel" Grid.Row="1" Grid.Column="1" Width="340" Margin="12,4,12,12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="SideDeviceHost" Focusable="False" IsTabStop="False" />
            <ContentControl x:Name="SideNowPlayingHost" Grid.Row="1" Focusable="False" IsTabStop="False" />
            <ContentControl x:Name="SideNotificationsHost" Grid.Row="2" Focusable="False" IsTabStop="False" Margin="0,10,0,0" />
        </Grid>

        <!-- Content layer: the selected page, with a status line for messages from any page. -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
        <Border Style="{StaticResource ContentLayer}">
            <TabControl x:Name="MainTabs" SelectedIndex="0" Style="{StaticResource ContentOnlyTabControl}" SelectionChanged="TabControl_SelectionChanged">
                <!-- Messages -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Conversation list -->
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                            <Grid Margin="16,20,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc messages}" Style="{StaticResource PaneHeader}" />
                                        <TextBlock x:Name="SmsStatusText" Text="{l:Loc select_a_phone_to_view_messages}" Style="{StaticResource CaptionText}"
                                                   Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72C;" VerticalAlignment="Top"
                                            ToolTip="{l:Loc refresh_messages}" AutomationProperties.Name="{l:Loc refresh_messages}" Click="RefreshPhoneData_Click" />
                                </Grid>
                                <TextBox x:Name="SmsSearchBox" Grid.Row="1" Margin="0,14,0,8" controls:Fluent.Placeholder="{l:Loc search_conversations}"
                                         controls:Fluent.Icon="&#xE721;" AutomationProperties.Name="{l:Loc search_conversations}"
                                         TextChanged="SmsSearchBox_TextChanged" />
                                <TextBlock Grid.Row="2" Text="{l:Loc no_conversations_yet}" HorizontalAlignment="Center" Margin="0,24,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=SmsThreadsList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox x:Name="SmsThreadsList" Grid.Row="2" SelectionChanged="SmsThreadsList_SelectionChanged"
                                         AutomationProperties.Name="{l:Loc conversations}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Avatar}" Width="40" Height="40" CornerRadius="20">
                                                    <TextBlock Text="{Binding Initials}" Style="{StaticResource AvatarInitials}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ThreadName" Text="{Binding DisplayName}" />
                                                    <TextBlock x:Name="ThreadSnippet" Text="{Binding Snippet}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding UpdatedAt.LocalDateTime, StringFormat={}{0:t}}" Style="{StaticResource CaptionText}"
                                                               HorizontalAlignment="Right" />
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                                            Margin="0,4,0,0" HorizontalAlignment="Right"
                                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="{Binding UnreadCount}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                    <Setter TargetName="ThreadName" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="ThreadSnippet" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Conversation -->
                        <Grid Grid.Column="1">
                            <StackPanel Style="{StaticResource NoThreadSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource EmptyStateGlyph}" />
                                <TextBlock Text="{l:Loc pick_a_conversation}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                                <TextBlock Text="{l:Loc your_phone_s_text_messages_show_up_here_choo}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>

                            <Grid Style="{StaticResource ThreadSelected}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Avatar}">
                                            <TextBlock Text="{Binding SelectedItem.Initials, ElementName=SmsThreadsList}" Style="{StaticResource AvatarInitials}" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedItem.DisplayName, ElementName=SmsThreadsList}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedItem.Address, ElementName=SmsThreadsList}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="SmsMessagesList" Grid.Row="1" Padding="20,12" ItemContainerStyle="{StaticResource PlainListItem}"
                                         AutomationProperties.Name="{l:Loc messages_in_conversation}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Border x:Name="Bubble" MaxWidth="480" HorizontalAlignment="Left" Padding="12,8,12,7"
                                                        CornerRadius="8,8,8,2" Background="{DynamicResource CardFillBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="MessageBody" Text="{Binding Body}" TextWrapping="Wrap" TextTrimming="None" />
                                                        <TextBlock x:Name="MessageTime" Text="{Binding SentAt.LocalDateTime, StringFormat={}{0:t}}"
                                                                   Style="{StaticResource CaptionText}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding FromMe}" Value="True">
                                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                                                    <Setter TargetName="Bubble" Property="CornerRadius" Value="8,8,2,8" />
                                                    <Setter TargetName="MessageBody" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                    <Setter TargetName="MessageTime" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                    <Setter TargetName="MessageTime" Property="Opacity" Value="0.75" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Grid.Row="2" Margin="20,8,20,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SmsReplyText" MinHeight="36" MaxHeight="140" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" controls:Fluent.Placeholder="{l:Loc enter_a_message}"
                                             AutomationProperties.Name="{l:Loc message_text}" />
                                    <Button Grid.Column="1" Style="{StaticResource AccentIconButton}" Content="&#xE724;" Margin="8,0,0,0"
                                            VerticalAlignment="Bottom" ToolTip="{l:Loc send}" AutomationProperties.Name="{l:Loc send_message}" Click="QueueSms_Click" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Photos -->
                <TabItem>
                    <Grid Margin="24,20,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc photos}" Style="{StaticResource PaneHeader}" />
                                <TextBlock x:Name="PhotosStatusText" Text="{l:Loc select_a_phone_to_browse_photos}" Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PhotoSelectionText" Text="{l:Loc 0_selected}" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SaveSelectedPhotos_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{l:Loc save}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AccentButton}" Click="OpenSelectedPhoto_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                        <TextBlock Text="{l:Loc open}" Foreground="{DynamicResource AccentTextBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="360" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PhotoSearchBox" controls:Fluent.Placeholder="{l:Loc search_photos}" controls:Fluent.Icon="&#xE721;"
                                     AutomationProperties.Name="{l:Loc search_photos}" TextChanged="PhotoSearchBox_TextChanged" />
                            <ComboBox x:Name="PhotoAlbumFilter" Grid.Column="1" Width="170" Margin="8,0,0,0"
                                      SelectionChanged="PhotoAlbumFilter_SelectionChanged" AutomationProperties.Name="{l:Loc filter_by_album}" />
                            <ComboBox x:Name="PhotoSortCombo" Grid.Column="2" Width="150" Margin="8,0,0,0" SelectedIndex="0"
                                      SelectionChanged="PhotoSortCombo_SelectionChanged" AutomationProperties.Name="{l:Loc photo_sort_order}">
                                <ComboBoxItem Content="{l:Loc newest_first}" Tag="newest" />
                                <ComboBoxItem Content="{l:Loc oldest_first}" Tag="oldest" />
                                <ComboBoxItem Content="{l:Loc largest_first}" Tag="largest" />
                                <ComboBoxItem Content="{l:Loc file_name}" Tag="name" />
                            </ComboBox>
                            <ComboBox x:Name="PhotoTileSizeCombo" Grid.Column="3" Width="120" Margin="8,0,0,0" SelectedIndex="1"
                                      SelectionChanged="PhotoTileSizeCombo_SelectionChanged" AutomationProperties.Name="{l:Loc photo_tile_size}">
                                <ComboBoxItem Content="{l:Loc small}" Tag="136" />
                                <ComboBoxItem Content="{l:Loc medium}" Tag="176" />
                                <ComboBoxItem Content="{l:Loc large}" Tag="220" />
                            </ComboBox>
                        </Grid>
                        <ListView x:Name="PhotosList" Grid.Row="2" Margin="-3,0,-12,0" SelectionMode="Extended"
                                  ItemContainerStyle="{StaticResource TileListItem}"
                                  MouseDoubleClick="PhotosList_MouseDoubleClick" SelectionChanged="PhotosList_SelectionChanged"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                                  ScrollViewer.CanContentScroll="True" AutomationProperties.Name="{l:Loc photos}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingWrapPanel ItemSize="176" Loaded="PhotoGridPanel_Loaded" Margin="0,0,12,0" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="Tile" ToolTip="{Binding FileName}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{l:Loc open}" Click="OpenPhotoInline_Click">
                                                    <MenuItem.Icon><TextBlock Text="&#xE8A7;" /></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Loc save_to_pc}" Click="SavePhotoInline_Click">
                                                    <MenuItem.Icon><TextBlock Text="&#xE74E;" /></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Border CornerRadius="6" Background="{DynamicResource ControlFillBrush}" Margin="2">
                                            <TextBlock Text="&#xEB9F;" Style="{StaticResource IconGlyph}" FontSize="22"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                        <!-- An image brush crops to the square tile from the centre and follows the rounded corners. -->
                                        <Border CornerRadius="6" Margin="2">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="Caption" CornerRadius="0,0,6,6" Margin="2" VerticalAlignment="Bottom" Padding="8,14,8,6"
                                                Visibility="Hidden">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#00000000" />
                                                    <GradientStop Offset="1" Color="#B0000000" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TakenAt.LocalDateTime, StringFormat={}{0:d MMM yyyy, HH:mm}}"
                                                           Foreground="#D0FFFFFF" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Caption" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- Files -->
                <TabItem>
                    <Grid Margin="24,20,24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc files}" Style="{StaticResource PaneHeader}" />
                            <TextBlock x:Name="StorageStatusText" Text="{l:Loc select_a_phone_to_browse_its_files}" Style="{StaticResource CaptionText}"
                                       Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                        <!-- Command bar -->
                        <Grid Grid.Row="1" Margin="0,16,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="{l:Loc action_back}" AutomationProperties.Name="{l:Loc go_back}"
                                    Click="StorageGoBack_Click" />
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="6,0,12,0">
                                <ItemsControl ItemsSource="{Binding Breadcrumbs, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding Name}" Style="{StaticResource SubtleButton}" FontSize="16" Padding="6,2"
                                                        Click="Breadcrumb_Click" />
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource IconGlyph}" FontSize="10" Margin="2,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBox x:Name="StorageSearchBox" Grid.Column="2" controls:Fluent.Placeholder="{l:Loc search_this_folder}"
                                     controls:Fluent.Icon="&#xE721;" AutomationProperties.Name="{l:Loc search_files}" TextChanged="StorageSearchBox_TextChanged" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DownloadStorageFile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{l:Loc download}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DangerButton}" Click="DeleteStorageItem_Click" AutomationProperties.Name="{l:Loc delete}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="{l:Loc delete}" Foreground="{DynamicResource DangerBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- Column header -->
                        <Grid Grid.Row="2" Margin="12,0,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Loc name}" Style="{StaticResource CaptionText}" Margin="40,0,0,0" />
                            <TextBlock Grid.Column="1" Text="{l:Loc details}" Style="{StaticResource CaptionText}" />
                        </Grid>
                        <Border Grid.Row="3" Style="{StaticResource PageCard}" Padding="4">
                            <ListBox x:Name="StorageItemsList" MouseDoubleClick="StorageItemsList_MouseDoubleClick" AutomationProperties.Name="{l:Loc files}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,7">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{l:Loc open}" Click="StorageOpenMenuItem_Click">
                                                        <MenuItem.Icon><TextBlock Text="&#xE8E5;" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{l:Loc download_to}" Click="StorageDownloadMenuItem_Click"
                                                              Visibility="{Binding IsFile, Converter={StaticResource BoolToVisConverter}}">
                                                        <MenuItem.Icon><TextBlock Text="&#xE896;" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="{l:Loc delete}" Click="StorageDeleteMenuItem_Click" Foreground="{DynamicResource DangerBrush}">
                                                        <MenuItem.Icon><TextBlock Text="&#xE74D;" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FileGlyph" Text="&#xE7C3;" Style="{StaticResource IconGlyph}" FontSize="18"
                                                       HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Details}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IconType}" Value="Folder">
                                                <Setter TargetName="FileGlyph" Property="Text" Value="&#xE8B7;" />
                                                <Setter TargetName="FileGlyph" Property="Foreground" Value="{DynamicResource CautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IconType}" Value="Image"><Setter TargetName="FileGlyph" Property="Text" Value="&#xEB9F;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconType}" Value="Audio"><Setter TargetName="FileGlyph" Property="Text" Value="&#xE8D6;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconType}" Value="Video"><Setter TargetName="FileGlyph" Property="Text" Value="&#xE8B2;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IconType}" Value="Document"><Setter TargetName="FileGlyph" Property="Text" Value="&#xE8A5;" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Apps -->
                <TabItem>
                    <Grid Margin="24,20,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc apps}" Style="{StaticResource PaneHeader}" />
                                <TextBlock x:Name="AppsStatusText" Text="{l:Loc select_a_phone_to_see_its_apps}" Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="0,0,8,0" ToolTip="{l:Loc refresh_apps}"
                                        AutomationProperties.Name="{l:Loc refresh_apps}" Click="RefreshApps_Click" />
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenAppWindow_Click"
                                        ToolTip="{l:Loc run_the_selected_app_in_its_own_pc_window_se}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{l:Loc open_in_window}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AccentButton}" Click="StartMirror_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEE64;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                        <TextBlock Text="{l:Loc open_phone_screen}" Foreground="{DynamicResource AccentTextBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="AppsSearchBox" Grid.Row="1" Margin="0,16,0,12" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                                 controls:Fluent.Placeholder="{l:Loc search_apps}" controls:Fluent.Icon="&#xE721;"
                                 TextChanged="AppsSearchBox_TextChanged" AutomationProperties.Name="{l:Loc search_apps}" />
                        <ListBox x:Name="AppsList" Grid.Row="2" Margin="-3,0,-12,0" ItemContainerStyle="{StaticResource TileListItem}"
                                 MouseDoubleClick="AppsList_MouseDoubleClick" KeyDown="AppsList_KeyDown" AutomationProperties.Name="{l:Loc phone_apps}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Margin="0,0,12,16" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="104" Margin="4,12,4,10" ToolTip="{Binding Label}">
                                        <Image Source="{Binding Icon}" Width="48" Height="48" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" TextAlignment="Center" FontSize="12" Margin="0,8,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- Settings -->
                <TabItem>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="16,20,8,0">
                            <TextBlock Text="{l:Loc settings}" Style="{StaticResource PaneHeader}" Margin="4,0,0,16" />
                            <RadioButton GroupName="SettingsNavigation" AutomationProperties.Name="{l:Loc general_settings}" Tag="0" IsChecked="True" Style="{StaticResource SettingsNavButton}"
                                         Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" Margin="0,0,14,0" />
                                    <TextBlock Text="{l:Loc general}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="SettingsNavigation" AutomationProperties.Name="{l:Loc devices_settings}" Tag="1" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EA;" Style="{StaticResource IconGlyph}" Margin="0,0,14,0" />
                                    <TextBlock Text="{l:Loc devices}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="SettingsNavigation" AutomationProperties.Name="{l:Loc phone_screen_settings}" Tag="2" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEE64;" Style="{StaticResource IconGlyph}" Margin="0,0,14,0" />
                                    <TextBlock Text="{l:Loc phone_screen}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="SettingsNavigation" AutomationProperties.Name="{l:Loc clipboard_settings}" Tag="3" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77F;" Style="{StaticResource IconGlyph}" Margin="0,0,14,0" />
                                    <TextBlock Text="{l:Loc clipboard}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DiagnosticsSettingsNav" GroupName="SettingsNavigation" AutomationProperties.Name="{l:Loc diagnostics_settings}" Tag="4" Style="{StaticResource SettingsNavButton}"
                                         Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource IconGlyph}" Margin="0,0,14,0" />
                                    <TextBlock Text="{l:Loc diagnostics}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TabControl x:Name="SettingsTabs" Grid.Column="1" SelectedIndex="0" Style="{StaticResource ContentOnlyTabControl}">
                            <!-- General -->
                            <TabItem>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16,20,32,32" MaxWidth="1000">
                                        <TextBlock Text="{l:Loc general}" Style="{StaticResource PageTitle}" Margin="0,0,0,8" />
                                        <TextBlock Text="{l:Loc appearance}" Style="{StaticResource SettingsGroupHeader}" />
                                        <Border Style="{StaticResource SettingsCard}">
                                            <DockPanel>
