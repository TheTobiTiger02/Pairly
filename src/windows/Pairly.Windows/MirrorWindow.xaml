<Window x:Class="Pairly.Windows.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Pairly.Windows.Localization"
        xmlns:controls="clr-namespace:Pairly.Windows.Controls"
        xmlns:mirror="clr-namespace:Pairly.Windows.Mirror"
        Title="{l:Loc phone_screen}" Icon="Assets/Pairly.ico" Width="460" Height="860" MinWidth="360" MinHeight="560"
        Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True" DragOver="MirrorWindow_DragOver" Drop="MirrorWindow_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <controls:InverseBooleanConverter x:Key="InverseBool" />
        <Style x:Key="NavBarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <controls:BrandMark Width="16" Height="16" Margin="0,0,10,0" />
                <TextBlock x:Name="DeviceTitleText" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="QualityText" Text="{l:Loc connecting}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" FontSize="13" Margin="0,4,2,0" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:Loc fit_window_to_phone_screen}"
                        AutomationProperties.Name="{l:Loc fit_window_to_phone_screen}" Click="FitButton_Click" />
                <Button x:Name="FullScreenButton" Style="{StaticResource IconButton}" Content="&#xE740;" FontSize="13" Margin="0,4,4,0"
                        VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:Loc enter_full_screen}"
                        AutomationProperties.Name="{l:Loc full_screen}" Click="FullScreenButton_Click" />
                <controls:CaptionButtons x:Name="MirrorCaptionButtons" />
            </StackPanel>
        </Grid>

        <!-- Phone video -->
        <Border Grid.Row="1" Background="{DynamicResource MediaBrush}" ClipToBounds="True" Margin="8,0,8,0" CornerRadius="8">
            <Grid>
                <!-- Hidden until video plays: WPF cannot draw the status overlay above an HwndHost
                     (airspace), so the surface has to get out of the way for the overlay to show. -->
                <mirror:MirrorSurfaceHost x:Name="Surface" Visibility="Hidden" />
                <Border x:Name="StatusOverlay" Background="{DynamicResource SolidBackgroundBrush}" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentSubtleBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,18">
                            <TextBlock Text="&#xEE64;" Style="{StaticResource IconGlyph}" FontSize="26" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock x:Name="OverlayTitleText" Text="{l:Loc connecting_to_your_phone}" Style="{StaticResource SubtitleText}" FontSize="18"
                                   TextAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock x:Name="OverlayBodyText" Text="{l:Loc allow_screen_capture_on_the_phone_if_it_asks}"
                                   Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,8,0,18" />
                        <Button x:Name="RetryButton" Content="{l:Loc try_again}" Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                                MinWidth="120" Visibility="Collapsed" Click="RetryButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Navigation bar -->
        <Grid Grid.Row="2" Margin="8,8,8,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource IconToggleButton}" Content="&#xE946;"
                              IsHitTestVisible="{Binding IsOpen, ElementName=AdvancedPopup, Converter={StaticResource InverseBool}}"
                              ToolTip="{l:Loc stream_details}" AutomationProperties.Name="{l:Loc stream_details}" />
                <Popup x:Name="AdvancedPopup" PlacementTarget="{Binding ElementName=AdvancedToggle}" Placement="Top"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-12"
                       IsOpen="{Binding IsChecked, ElementName=AdvancedToggle, Mode=TwoWay}">
                    <Border Style="{StaticResource FlyoutBorder}" Width="320" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{l:Loc stream_details}" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="AdvancedText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="AudioButton" Style="{StaticResource IconButton}" Content="&#xE767;" Margin="4,0,0,0"
                        Visibility="Collapsed" ToolTip="{l:Loc mute_phone_sound_on_this_pc}"
                        AutomationProperties.Name="{l:Loc phone_sound_on_this_pc}" Click="AudioButton_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource NavBarButton}" Content="&#xE76B;" ToolTip="{l:Loc action_back}" AutomationProperties.Name="{l:Loc phone_back}"
                        Click="BackButton_Click" />
                <Button Style="{StaticResource NavBarButton}" Content="&#xEA3A;" ToolTip="{l:Loc home}" AutomationProperties.Name="{l:Loc phone_home}"
                        Click="HomeButton_Click" />
                <Button Style="{StaticResource NavBarButton}" Content="&#xE7C4;" ToolTip="{l:Loc recent_apps}" AutomationProperties.Name="{l:Loc recent_apps}"
                        Click="RecentsButton_Click" />
            </StackPanel>

            <Button Style="{StaticResource IconButton}" Content="&#xE71A;" HorizontalAlignment="Right" Foreground="{DynamicResource DangerBrush}"
                    ToolTip="{l:Loc stop_phone_screen}" AutomationProperties.Name="{l:Loc stop_phone_screen}" Click="StopButton_Click" />
        </Grid>
    </Grid>
</Window>
