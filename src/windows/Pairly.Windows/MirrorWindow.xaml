<Window x:Class="Pairly.Windows.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Pairly.Windows.Localization"
        xmlns:mirror="clr-namespace:Pairly.Windows.Mirror"
        Title="{l:Loc phone_screen}" Icon="Assets/Pairly.ico" Width="400" Height="820" MinWidth="320" MinHeight="320"
        Style="{StaticResource {x:Type Window}}" Background="{DynamicResource MediaBrush}" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="MirrorWindow_DragOver" Drop="MirrorWindow_Drop">
    <!-- The video is the whole window: no caption, a resize border, and Windows 11's own rounded
         corners and hairline frame. The controls float above it in owned windows (see Mirror/). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Storyboard x:Key="SpinnerSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.1" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource MediaBrush}">
        <!-- Hidden until video plays: WPF cannot draw the status card above an HwndHost (airspace),
             so the surface has to get out of the way for the card to show. -->
        <mirror:MirrorSurfaceHost x:Name="Surface" Visibility="Hidden" />

        <Grid x:Name="StatusOverlay" Background="{DynamicResource SolidBackgroundBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Margin="24,56,24,90">
                <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Ellipse x:Name="StatusDisc" Fill="{DynamicResource AccentSubtleBrush}" />
                    <!-- Spinning arc while connecting. -->
                    <Ellipse x:Name="SpinnerArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                             StrokeDashArray="14 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="StatusGlyph" Text="&#xE8EA;" Style="{StaticResource IconGlyph}" FontSize="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                </Grid>
                <TextBlock x:Name="OverlayTitleText" Text="{l:Loc connecting_to_your_phone}" Style="{StaticResource SubtitleText}"
                           FontSize="18" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="OverlayBodyText" Text="{l:Loc allow_screen_capture_on_the_phone_if_it_asks}"
                           Style="{StaticResource BodyText}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center" Margin="0,8,0,20" />
                <Button x:Name="RetryButton" Content="{l:Loc try_again}" Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                        MinWidth="120" Visibility="Collapsed" Click="RetryButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
